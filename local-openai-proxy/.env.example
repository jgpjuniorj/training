### Example environment file for local-openai-proxy
# Comma-separated allowed API keys for clients (e.g. VS Code). If omitted a key will be generated
PROXY_API_KEYS=your_local_key_here

# URL where Ollama is listening
OLLAMA_URL=http://localhost:11434

# Bearer token Ollama expects (default 'ollama')
OLLAMA_BEARER=ollama

# Proxy port (default 11435)
PORT=11435
